# این فایل را به .env کپی کنید و در صورت نیاز مقادیر را تغییر دهید:
#   cp .env.example .env
# (اگر .env نسازید، مقادیر پیش‌فرض docker-compose.yml استفاده می‌شود)

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

